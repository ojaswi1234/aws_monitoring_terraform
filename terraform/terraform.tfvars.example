# ==============================================================================
# Terraform Variables Example Configuration
# Copy this file to terraform.tfvars and customize with your own values:
#   cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# AWS Region (Mumbai by default)
aws_region = "ap-south-1"

# Project naming prefix
project_name = "devops-self-healing"

# Environment
environment = "dev"

# Administrator Public IP or CIDR block
# To secure access, change to your specific IP: e.g. "203.0.113.45/32"
admin_ip = "0.0.0.0/0"

# EC2 Instance Type (t2.micro / t3.micro are AWS Free Tier eligible)
instance_type = "t2.micro"

# SSH Key paths (defaults to ~/.ssh/id_rsa.pub and ~/.ssh/id_rsa)
ssh_public_key_path  = "~/.ssh/id_rsa.pub"
ssh_private_key_path = "~/.ssh/id_rsa"

# Disk storage sizes in GB (Total 30GB is covered under AWS Free Tier)
monitor_disk_size = 20
app_disk_size     = 10
