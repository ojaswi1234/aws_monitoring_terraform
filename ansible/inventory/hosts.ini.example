# Example Ansible Inventory
# Replace placeholder IPs with your Terraform outputs or run scripts/generate_inventory.sh

[monitoring]
monitor-server ansible_host=203.0.113.10 internal_ip=10.0.1.50

[webservers]
app-server ansible_host=203.0.113.20 internal_ip=10.0.1.60

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

# Cross-server communication variables
app_server_private_ip=10.0.1.60
monitor_server_private_ip=10.0.1.50
nagios_admin_user=nagiosadmin
nagios_admin_password=AdminNagiosSecure2026!
flask_app_port=8000
flask_service_name=flask-backend
