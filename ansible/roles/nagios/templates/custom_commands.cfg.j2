# ==============================================================================
# Custom Nagios Monitoring & Self-Healing Event Handler Commands
# ==============================================================================

# Custom HTTP check with expected status code and body string
define command {
    command_name    check_http_custom
    command_line    $USER1$/check_http -H $HOSTADDRESS$ -p $ARG1$ -u "$ARG2$" -e "$ARG3$" -s "$ARG4$" -t 10
}

# NRPE check command
define command {
    command_name    check_nrpe_1arg
    command_line    $USER1$/check_nrpe -H $HOSTADDRESS$ -c $ARG1$
}

# Self-Healing Event Handler: Recover Flask Backend
define command {
    command_name    recover_flask_event_handler
    command_line    /usr/local/bin/recover_flask.sh "$SERVICESTATE$" "$SERVICESTATETYPE$" "$SERVICEATTEMPT$"
}

# Self-Healing Event Handler: Recover Nginx Web Server
define command {
    command_name    recover_nginx_event_handler
    command_line    /usr/local/bin/recover_nginx.sh "$SERVICESTATE$" "$SERVICESTATETYPE$" "$SERVICEATTEMPT$"
}
