*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
